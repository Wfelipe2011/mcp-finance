POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# For scripts running on the host (outside Docker)
DATABASE_URL=postgres://finance:finance@localhost:5434/finance
# Note: docker-compose.yml overrides DATABASE_URL for the api-server container
# using hostname "postgres" (the service name) and internal port 5432

AI_BASE_URL=http://192.168.0.209:8080/v1
AI_MODEL=gemma-4

# Web server port (default: 3001)
PORT=3001

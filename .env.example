# =============================================================================
# mcp-finance — Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# Nunca comite o .env real no git.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Usuário, senha e banco criados automaticamente pelo container postgres
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# URL usada por scripts rodando no HOST (fora do Docker, ex: bun run sync)
# Dentro do Docker o compose sobrescreve DATABASE_URL automaticamente.
DATABASE_URL=postgres://finance:finance@localhost:5434/finance

# -----------------------------------------------------------------------------
# Pluggy (Open Finance)
# -----------------------------------------------------------------------------
# E-mail e senha da conta Pluggy usada para autenticação via serviço auth.
# Crie sua conta em: https://dashboard.pluggy.ai
PLUGGY_EMAIL=seu@email.com
PLUGGY_PASSWORD=sua-senha-pluggy

# -----------------------------------------------------------------------------
# IA (LLM local ou API)
# -----------------------------------------------------------------------------
# URL base da API compatível com OpenAI (ex: LM Studio, Ollama, OpenAI)
AI_BASE_URL=http://localhost:11434/v1

# Nome do modelo a usar (ex: gemma-4, llama3, gpt-4o)
AI_MODEL=gemma-4

# -----------------------------------------------------------------------------
# Autenticação do App (login da interface web)
# -----------------------------------------------------------------------------
# Usuário e senha para acessar a interface web (single-user)
APP_USERNAME=admin
APP_PASSWORD=troque-esta-senha

# Segredo usado para assinar JWTs — MUDE para uma string aleatória longa!
# Gere com: openssl rand -base64 32
APP_SECRET=TROQUE-ME-para-um-valor-aleatorio-longo

# -----------------------------------------------------------------------------
# Configurações do servidor (opcional)
# -----------------------------------------------------------------------------
# Porta do servidor API (padrão: 3001)
PORT=3001

# URL do serviço de token Pluggy — usado por scripts fora do Docker.
# Dentro do Docker o compose injeta automaticamente http://auth:3000/token
TOKEN_URL=http://localhost:3000/token

# -----------------------------------------------------------------------------
# Super Admin (acesso ao painel de administração)
# -----------------------------------------------------------------------------
# Conta única de super administrador — gerencia tenants e workers via /api/admin/*
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=troque-esta-senha-admin
